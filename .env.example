# Public Firebase web config (safe for client apps).
# Fill these after:
#   npx -y firebase-tools@latest apps:create web craft-docs-landing --project <PROJECT_ID>
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# CraftDocs app Supabase — same project as invoice-generator admin plans
# (anon key is public; RLS allows reading active plans only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
